{
  "name": "VocabWord",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "description": "Unit or list name the word belongs to, e.g. Unit 1"
    },
    "term": {
      "type": "string",
      "description": "The vocabulary word"
    },
    "definition": {
      "type": "string",
      "description": "What the word means"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words that mean the same thing"
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words that mean the opposite"
    },
    "root": {
      "type": "string",
      "description": "Greek or Latin root, e.g. bene"
    },
    "rootMeaning": {
      "type": "string",
      "description": "What the root means, e.g. good"
    }
  },
  "required": [
    "unit",
    "term"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}