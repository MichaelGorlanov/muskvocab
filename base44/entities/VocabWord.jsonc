{
  "name": "VocabWord",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "description": "Lesson or list name the word belongs to, e.g. Lesson 1"
    },
    "term": {
      "type": "string",
      "description": "The vocabulary word"
    },
    "partOfSpeech": {
      "type": "string",
      "description": "n., v. or adj."
    },
    "definition": {
      "type": "string",
      "description": "What the word means"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words that mean the same thing"
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words that mean the opposite"
    },
    "root": {
      "type": "string",
      "description": "Greek or Latin root, e.g. bene"
    },
    "rootMeaning": {
      "type": "string",
      "description": "What the root means, e.g. good"
    }
  },
  "required": [
    "unit",
    "term"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}